# ---------------------------------------------------------------- build output
build/
app/build/
# Gradle sometimes emits APKs here depending on the task; it is still output, not source.
app/debug/
app/release/
.gradle/
.kotlin/
.idea/
*.iml
*.apk
captures/
.externalNativeBuild/
.cxx/

# ---------------------------------------------------------------- local config & secrets
# Machine-specific SDK path, and the API endpoint the local build targets.
local.properties
# Signing material. Never commit the keystore: leaking it lets anyone publish
# updates that Android will accept as yours.
keystore.properties
*.jks
*.keystore
*.p12
# The relay's generated config, written by server/deploy.sh. It holds that deployment's access
# token, which is machine-local state rather than source — committing it would hand out the key to
# whoever runs the relay.
server/together.env

# ---------------------------------------------------------------- development scaffolding
# The scripts in tools/ are development helpers. They hardcode this machine's paths
# (e.g. the Android SDK location and a scratch screenshot directory) and the API
# endpoint used while developing, so they are neither portable nor safe to publish.
# Set api.base.url in local.properties to build against your own endpoint instead.
tools/
plans/

# Development log: the round-by-round fix history from before publication. It contains
# the API endpoint, quotes from the development conversation, and this machine's paths
# and device model, so it is kept local only.
docs/DEVLOG.md

# ---------------------------------------------------------------- logs / scratch
*.log

# Rendered previews and screenshots: these embed album artwork and other apps' UI,
# so they are not redistributable even though the code is.
#
# App resources are re-included: the launcher icon and the splash mark are PNGs, and excluding them
# would ship a repository whose build is missing its own icon.
*.png
*.jpg
*.jpeg
!app/src/main/res/drawable*/**/*.png
!docs/screenshots/*.png

# ---------------------------------------------------------------- fonts
# SF Pro is Apple's font and its licence does not permit redistribution in a
# third-party repository. Supply your own copy locally, or swap SFPro in
# ui/theme/Type.kt for a freely-licensed family.
app/src/main/res/font/sf_pro.ttf
