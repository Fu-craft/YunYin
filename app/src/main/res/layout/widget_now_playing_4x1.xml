<?xml version="1.0" encoding="utf-8"?>
<!--
    4×1: one line of context next to the cover. No progress bar (there is no vertical room for one that
    would not look like a divider), and only the play control besides the text.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="12dp">

    <ImageView
        android:id="@+id/widget_cover"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/widget_cover_description"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_ticker_note_white" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="6dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_label"
            android:textSize="14sp"
            android:text="@string/widget_idle" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/widget_play"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/widget_play"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_play"
        android:tint="@color/widget_accent" />
</LinearLayout>
