<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Host theme.

      There is no in-app launch screen: the platform splash (Android 12+ always draws one) shows the
      white background and the launcher mark, and stays up only until the first Compose frame — which
      is already the real UI. The window background is the same white as the platform splash, so the
      handover cannot flash black or white-then-theme.

      The status bar text is dark, since the platform launch ground is white.
    -->
    <style name="Theme.YunYin" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Dark status-bar icons on the white launch ground; Compose updates them per theme. -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>

        <!-- Platform splash (API 31+; minSdk is 33, so this is always in effect). -->
        <item name="android:windowSplashScreenBackground">@color/brand_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
