<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher mark for 云音 (foreground layer of the adaptive icon).

  A single eighth note with a tapered flag. Geometry is generated by tools/icon_final.py, which
  also renders this exact geometry for review, so the drawable and the reviewed preview cannot
  drift apart.

  Notes on the shape, from rendering it at full size during design:
    * the head is a slightly *tilted* ellipse (a flat oval reads as a balloon);
    * the flag is a filled shape with real body that tapers to a point, not a thin stroke, since a
      stroked flag came out as a needle-like sliver;
    * the whole mark is centred on (54, 54): its bounding box centre is (54.3, 53.9).

  Safe zone: the furthest point from the icon centre is 30.0, inside the adaptive-icon safe circle
  of radius 33, so no launcher mask crops it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Note head: tilted ellipse, four cubic segments. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M59.14,65.79C60.95,70.27 57.64,75.82 51.75,78.2C45.87,80.58 39.63,78.88 37.82,74.41C36.01,69.93 39.32,64.38 45.21,62C51.09,59.62 57.33,61.32 59.14,65.79Z" />

    <!-- Stem. -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:pathData="M58.6,68.38L58.6,28.47" />

    <!-- Flag: filled, sweeping right from the stem top and tapering to a point. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M58.6,28.47C71.48,31.46 74.01,40.66 68.72,48.94C66.42,42.5 62.51,37.44 58.6,35.6Z" />
</vector>
