<?xml version="1.0" encoding="utf-8"?>
<!--
  Icon background for 云音.

  Sky blue to deep azure. Blue reads as airy and calm, matching 云 ("cloud"), and it deliberately
  avoids the red used by both Apple Music and NetEase Cloud Music so the icon does not look like a
  clone of either.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="86" android:endY="108">
                <item android:offset="0" android:color="#FF6EC6FF" />
                <item android:offset="0.62" android:color="#FF3C6BFF" />
                <item android:offset="1" android:color="#FF2A55F0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
